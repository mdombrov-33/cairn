ENV=dev
APP_NAME=cairn
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://cairn:cairn@localhost:5433/cairn

# LLM - set to "frontier" to use a real provider instead of local Ollama
LLM_ENV=local

# Override active prompt versions per agent (JSON map). Default is v1 for all.
# LLM_PROMPT_VERSIONS={"intent_router": "v2"}

# Provider API keys — read directly by LiteLLM from os.environ, only needed when LLM_ENV=frontier
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
